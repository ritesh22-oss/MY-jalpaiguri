# Jalpaiguri Connect - Environment Variables Example
# Live Backend Endpoints (Used by Vite Web and Expo Mobile)
VITE_API_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_BACKEND_URL=
PORT=3000

# Optional: Only needed if running the local Express server offline instead of cloud backend
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
