{
  "expo": {
    "name": "Jalpaiguri Connect",
    "slug": "jalpaiguri-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/durga-ma-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalpaiguri.connect"
    },
    "android": {
      "package": "com.jalpaiguri.connect",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/durga-ma-icon.png",
        "backgroundColor": "#FAF8F5"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./public/durga-ma-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Jalpaiguri Connect to access your location to show nearby emergency services and local shops."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "312a0ed0-2eee-41ad-ad4f-5f9bd5c8294e"
      }
    }
  }
}
