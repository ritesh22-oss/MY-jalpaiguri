  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user profiles"
    },
    "workers/{workerId}": {
      "schema": "Worker",
      "description": "Available workers directory"
    },
    "shops/{shopId}": {
      "schema": "Shop",
      "description": "Verified shops directory"
    },
    "civic_reports/{reportId}": {
      "schema": "CivicReport",
      "description": "Civic issues reported by citizens"
    },
    "blood_donors/{donorId}": {
      "schema": "BloodDonor",
      "description": "Registered blood donors"
    },
    "local_alerts/{alertId}": {
      "schema": "LocalAlert",
      "description": "Local and official alerts"
    },
    "restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Verified restaurants directory"
    },
    "restaurants/{restaurantId}/menuItems/{menuItemId}": {
      "schema": "MenuItem",
      "description": "Menu items for a restaurant"
    },
    "puja_pandals/{pandalId}": {
      "schema": "DurgaPandal",
      "description": "Durga Puja pandals directory and submission queue"
    },
    "puja_pandals/{pandalId}/reviews/{reviewId}": {
      "schema": "PandalReview",
      "description": "User ratings and reviews for a specific pandal"
    },
    "users/{userId}/saved_pandals/{pandalId}": {
      "schema": "SavedPandal",
      "description": "User saved pandals"
    },
    "pandal_reports/{reportId}": {
      "schema": "PandalReport",
      "description": "Correction reports for Durga Puja pandals"
    }
  }
}