{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "age": {
          "type": "number"
        },
        "gender": {
          "type": "string",
          "enum": [
            "Male",
            "Female",
            "Other",
            "Prefer not to say"
          ]
        },
        "bloodGroup": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "avatarUrl": {
          "type": "string"
        },
        "isVolunteer": {
          "type": "boolean"
        },
        "isBloodDonor": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "enum": [
            "English",
            "বাংলা",
            "हिन्दी"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "citizen",
            "admin",
            "worker",
            "shop_owner"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "phone",
        "location",
        "language",
        "createdAt"
      ]
    },
